{
  "name": "adid-extension-final",
  "private": true,
  "version": "0.0.0",
  "type": "module",
"scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "copy-root-files": "copyfiles manifest.json \"options/**\" dist",
    "copy-src-files": "copyfiles -u 1 \"src/background/**\" \"src/icons/**\" dist",
    "build": "npm-run-all build:vite copy-root-files copy-src-files"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.3",
    "copyfiles": "^2.4.1",
    "npm-run-all": "^4.1.5",
    "vite": "^4.4.5"
  }
}
